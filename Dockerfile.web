FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_BACKEND=gateway
ARG VITE_GATEWAY_URL=
ENV VITE_BACKEND=${VITE_BACKEND} VITE_GATEWAY_URL=${VITE_GATEWAY_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/entrypoint.sh /entrypoint-jarvis.sh
RUN chmod +x /entrypoint-jarvis.sh
EXPOSE 8080
ENTRYPOINT ["/entrypoint-jarvis.sh"]
