FROM node:22-alpine
ENV NODE_ENV=production JARVIS_GATEWAY_HOST=0.0.0.0 JARVIS_GATEWAY_PORT=8790 JARVIS_DATA_DIR=/app/data
WORKDIR /app
COPY gateway ./gateway
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:8790/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "gateway/server.mjs"]
