{
  "name": "jarvis",
  "private": true,
  "version": "0.0.23",
  "description": "A browser voice assistant with an Iron Man holographic interface, driven by Claude Code through a small Node bridge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "JARVIS_ALLOW_WRITES=1 node bridge/server.mjs",
    "setup": "node scripts/setup.mjs",
    "gateway": "node gateway/server.mjs",
    "test:gateway:tasks": "node gateway/test-tasks.mjs",
    "test:gateway:plans": "node gateway/test-plans.mjs",
    "test:gateway:plan-generator": "node gateway/test-plan-generator.mjs",
    "test:gateway:agent-runner": "node gateway/test-agent-runner.mjs",
    "test:gateway:research": "node gateway/test-research.mjs",
    "test:gateway:browser": "node gateway/test-browser.mjs",
    "test:gateway:search": "node gateway/test-search.mjs",
    "test:gateway:search-api": "node gateway/test-search-api.mjs",
    "test:gateway:documents": "node gateway/test-documents.mjs",
    "test:gateway:document-qa": "node gateway/test-document-qa.mjs",
    "test:gateway:vision": "node gateway/test-vision.mjs",
    "test:gateway:document-extract": "node gateway/test-document-extract.mjs",
    "test:gateway:memory-engine": "node gateway/test-memory-engine.mjs",
    "test:gateway:all": "node scripts/test-gateway-all.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "test:gateway:provider": "node gateway/test-provider-integration.mjs",
    "test:gateway:orbit": "node gateway/test-orbit-catalog.mjs",
    "test:gateway:device-telemetry": "node gateway/test-device-telemetry.mjs",
    "test:robotics:safety": "python3 -m unittest discover -s robotics/exoskeleton_safety/tests -p \"test_*.py\"",
    "test:orbit:live": "node scripts/test-orbit-live.mjs",
    "test:provider:live": "node scripts/test-live-provider.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
