limit_req_zone $binary_remote_addr zone=jarvis_api:10m rate=30r/m;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  auth_basic "JARVIS private workspace";
  auth_basic_user_file /etc/nginx/.htpasswd;
  client_max_body_size 6m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)" always;

  location /v1/ {
    limit_req zone=jarvis_api burst=20 nodelay;
    proxy_pass http://gateway:8790;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin "";
    proxy_set_header Authorization "Bearer ${JARVIS_GATEWAY_TOKEN}";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 100s;
    proxy_send_timeout 100s;
  }

  location = /health {
    proxy_pass http://gateway:8790/health;
    proxy_set_header Origin "";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:js|css|svg|png|jpg|jpeg|webp|woff2?)$ {
    expires 7d;
    add_header Cache-Control "public, max-age=604800, immutable";
    try_files $uri =404;
  }
}
